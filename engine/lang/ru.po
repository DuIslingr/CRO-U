msgid "With a controller:"
msgstr "При использовании геймпада:"

#: src/app/scene_fx.cpp:1125
msgid ""
"○ (the right button) confirms, × (the bottom one) goes back - as on the Vita"
msgstr ""
"○ (правая кнопка) подтверждает, × (нижняя) возвращает назад — как на Vita"

#: src/app/scene_fx.cpp:1126
msgid "× (the bottom button) confirms, ○ (the right one) goes back"
msgstr "× (нижняя кнопка) подтверждает, ○ (правая) возвращает назад"

