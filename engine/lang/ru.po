msgid "Needs the Vulkan renderer"
msgstr "Требуется рендерер Vulkan"

#: src/app/scene_fx.cpp:1268
msgid "Anti-aliasing"
msgstr "Сглаживание"

#: src/app/scene_fx.cpp:1273
msgid "Temporal: jittered frames accumulated (MSAA is off meanwhile)"
